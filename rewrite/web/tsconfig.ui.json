  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "isolatedModules": true,
    "lib": ["ES2022", "DOM"], "types": ["vite/client"], "skipLibCheck": true
