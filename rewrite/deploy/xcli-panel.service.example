# panel.env is generated by the installer from validated settings and monitor configuration.
[Unit]
Description=XCLI Rust management service
After=network-online.target xcli-core.service
Wants=network-online.target xcli-core.service

[Service]
User=xgateway
Group=xgateway
SupplementaryGroups=xgmonitor
EnvironmentFile=/etc/xcli/panel.env
ExecStart=/usr/local/lib/xcli/xcli-panel-service --experimental --db /var/lib/xcli/gateway.sqlite --secret-key /etc/xcli/security.key --settings /etc/xcli/settings.json --origin ${XCLI_ORIGIN} --port 18080 --core-binary /usr/local/lib/xcli/xray --core-api 127.0.0.1:10085 --core-pid-file /sys/fs/cgroup/system.slice/xcli-core.service/cgroup.procs --core-tags auto --core-probe-uuid ${XCLI_PROBE_UUID} --monitor-report /var/lib/xcli-monitor/report.json --experimental-disk-probe /usr/local/lib/xcli/xcli-host-disk-probe --experimental-import-report-dir /var/lib/xcli-import/report --experimental-import-report-gid ${XCLI_PANEL_GID} --experimental-import-inbox /var/lib/xcli/proxy-import --experimental-import-apply true --experimental-notification-delivery true --automatic-backups true
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xcli
CapabilityBoundingSet=
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
