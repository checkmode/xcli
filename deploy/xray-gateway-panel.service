[Unit]
Description=Xdistribute management panel
After=network-online.target xray-gateway-core.service
Wants=xray-gateway-core.service
[Service]
User=xgateway
Group=xgateway
WorkingDirectory=/opt/xray-gateway
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 127.0.0.1 --port 8080 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=2
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/xray-gateway
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077
[Install]
WantedBy=multi-user.target
